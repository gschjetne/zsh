# Tests for completing after glob patterns and brace expansions in the
# leading directories of a path.  The pattern stays on the line as typed
# and only names that exist under every directory it expands to are
# offered.
#
# The fixture is a matrix of environment x region directories:
#
#   dev/{eu-west-1,us-east-1}/      app.yaml db.yaml debug.yaml
#   prod/{eu-west-1,us-east-1}/     app.yaml db.yaml alarms.yaml certs/tls.pem
#   qa1/eu-west-1/ qa2/eu-west-1/   app.yaml db.yaml qa.yaml
#   qa3/eu-west-1/                  app.yaml qa.yaml

%prep
  ZSH_TEST_LANG=$(ZTST_find_UTF8)
  if ( zmodload zsh/zpty 2>/dev/null ); then
    . $ZTST_srcdir/comptest
    mkdir globdirs.tmp
    cd globdirs.tmp
    for d in dev/{eu-west-1,us-east-1}; do
      mkdir -p $d && touch $d/{app,db,debug}.yaml
    done
    for d in prod/{eu-west-1,us-east-1}; do
      mkdir -p $d/certs && touch $d/{app,db,alarms}.yaml $d/certs/tls.pem
    done
    for d in qa{1,2}/eu-west-1; do
      mkdir -p $d && touch $d/{app,db,qa}.yaml
    done
    mkdir -p qa3/eu-west-1 && touch qa3/eu-west-1/{app,qa}.yaml
    comptestinit -z $ZTST_testdir/../Src/zsh &&
    comptesteval \
      'zstyle ":completion:*" completer _complete _ignored' \
      'expand-or-complete-with-report () {
        print -lr "<WIDGET><expand-or-complete>"
        zle expand-or-complete
        print -lr - "<LBUFFER>$LBUFFER</LBUFFER>" "<RBUFFER>$RBUFFER</RBUFFER>"
        zle clear-screen
        zle -R
      }' \
      'zle -N expand-or-complete-with-report' \
      'bindkey "^I" expand-or-complete-with-report'
  else
    ZTST_unimplemented="the zsh/zpty module is not available"
  fi

%test

# Tab is expand-or-complete (the default binding) with the default
# completers, unless stated otherwise.

  comptest $': {dev,prod}/eu-west-1/\t'
0:braces: list only names under both directories
>line: {: {dev,prod}/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{db.yaml}

  comptest $': {dev,prod}/eu-west-1/d\t'
0:braces: debug.yaml (dev only) is not a candidate
>line: {: {dev,prod}/eu-west-1/db.yaml }{}

  comptest $': prod/{eu-west-1,us-east-1}/\t'
0:braces in a later directory, including a common subdirectory
>line: {: prod/{eu-west-1,us-east-1}/}{}
>DESCRIPTION:{file}
>FI:{alarms.yaml}
>FI:{app.yaml}
>DI:{certs}
>FI:{db.yaml}

  comptest $': prod/{eu-west-1,us-east-1}/c/t\t'
0:braces followed by partial directories
>line: {: prod/{eu-west-1,us-east-1}/certs/tls.pem }{}

  comptest $': {dev,nope}/eu-west-1/\t'
0:braces: no candidates if an alternative does not exist
>line: {: {dev,nope}/eu-west-1/}{}

  comptest $': qa{1..3}/eu-west-1/\t'
0:brace range
>line: {: qa{1..3}/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{qa.yaml}

  comptest $': */eu-west-1/\t'
0:star: only app.yaml exists under all five environments
>line: {: */eu-west-1/app.yaml }{}

  comptest $': p*/*/\t'
0:star in two directories
>line: {: p*/*/}{}
>DESCRIPTION:{file}
>FI:{alarms.yaml}
>FI:{app.yaml}
>DI:{certs}
>FI:{db.yaml}

  comptest $': */*/c\t'
0:star: certs/ exists only under prod, so no candidates
>line: {: */*/c}{}

  comptest $': qa?/eu-west-1/\t'
0:question mark
>line: {: qa?/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{qa.yaml}

  comptest $': qa[12]/eu-west-1/\t'
0:bracket expression
>line: {: qa[12]/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{db.yaml}
>FI:{qa.yaml}

  comptest $': qa[^3]/eu-west-1/d\t'
0:negated bracket expression
>line: {: qa[^3]/eu-west-1/db.yaml }{}

  comptest $': qa<1-2>/eu-west-1/d\t'
0:numeric range
>line: {: qa<1-2>/eu-west-1/db.yaml }{}

  comptest $': (dev|prod)/us-east-1/\t'
0:alternation
>line: {: (dev|prod)/us-east-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{db.yaml}

  comptest $': qa\\?/eu-west-1/\t'
0:quoted pattern character is literal: no directory qa?
>line: {: qa\?/eu-west-1/}{}

  comptesteval 'setopt extendedglob'
  comptest $': ^qa?/eu-west-1/\t'
0:extendedglob: negation
>line: {: ^qa?/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{db.yaml}

  comptest $': qa[12]#/eu-west-1/\t'
0:extendedglob: repetition
>line: {: qa[12]#/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{db.yaml}
>FI:{qa.yaml}

  comptest $': (*~qa3)/eu-west-1/\t'
0:extendedglob: exclusion
>line: {: (*~qa3)/eu-west-1/}{}
>DESCRIPTION:{file}
>FI:{app.yaml}
>FI:{db.yaml}

  comptest $': (#i)PROD/*/al\t'
0:extendedglob: case-insensitive glob flag
>line: {: (#i)PROD/*/alarms.yaml }{}

  comptesteval 'unsetopt extendedglob'
  comptest $': prod/eu-west-1/a*\t'
0:a pattern in the last component is still expanded
>line: {: prod/eu-west-1/alarms.yaml prod/eu-west-1/app.yaml }{}

  comptest $': {dev,prod}/eu-west-1/db.yaml\t'
0:a complete name after a pattern is not expanded
>line: {: {dev,prod}/eu-west-1/db.yaml }{}

  comptesteval 'zstyle ":completion:*" completer _expand _complete' \
               'bindkey "^I" complete-word-with-report'
  comptest $': {dev,prod}/eu-west-1/d\t'
0:_expand completer leaves a pattern prefix to completion
>line: {: {dev,prod}/eu-west-1/db.yaml }{}

  comptest $': prod/eu-west-1/a*\t'
0:_expand completer still expands a pattern in the last component
>line: {: prod/eu-west-1/alarms.yaml }{}
>DESCRIPTION:{expansions}
>FI:{prod/eu-west-1/alarms.yaml}
>FI:{prod/eu-west-1/app.yaml}
>DESCRIPTION:{all expansions}
>NO:{prod/eu-west-1/alarms.yaml prod/eu-west-1/app.yaml}
>DESCRIPTION:{original}
>NO:{prod/eu-west-1/a*}

%clean

  zmodload -ui zsh/zpty
